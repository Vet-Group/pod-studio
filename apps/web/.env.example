# Copy to .env.local for `pnpm dev`. Test runs do not read this file; they use tests/support defaults.
# Values match ops/local/docker-compose.yml and are local-only.
PGHOST=127.0.0.1
PGPORT=54316
PGUSER=pod
PGPASSWORD=pod-local-only
PGDATABASE=pod_dev
S3_ENDPOINT=http://127.0.0.1:19000
# Optional browser-facing path-style endpoint when S3_ENDPOINT is internal to Docker.
# S3_PUBLIC_ENDPOINT=https://app.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=podlocal
S3_SECRET_ACCESS_KEY=pod-local-only
S3_BUCKET=pod-dev

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3100
# AES-256-GCM keys: generate 32 random bytes, base64 encode them; never commit actual keys.
# Keep old versions during rotation, select the active version, then re-encrypt each connection.
SHOPIFY_ENCRYPTION_KEYS=v1:<BASE64_32_BYTE_KEY>
SHOPIFY_ENCRYPTION_ACTIVE_VERSION=v1
# Optional loopback-only Shopify stub endpoint; ignored in production.
# SHOPIFY_ENDPOINT_OVERRIDE=http://127.0.0.1:13125/graphql
