# Copy to ops/prod/.env on the server, fill every value, then `chmod 600 ops/prod/.env`.
# Never commit the filled file (.gitignore excludes .env.*, this example is the only exception).
# Generate secrets with: openssl rand -base64 32   (use `openssl rand -hex 24` for passwords)

# Public hostname; DNS A/AAAA must point at this server before the first start (Caddy issues TLS).
APP_DOMAIN=studio.example.com
ACME_EMAIL=ops@example.com
# Image built by ops/docker/Dockerfile, e.g. ghcr.io/<owner>/pod-studio-web:<git-sha>
APP_IMAGE=pod-studio-web:latest

POSTGRES_USER=pod
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=pod_studio

# MinIO root account (admin only, used by minio-init) and the app's least-privilege account.
MINIO_ROOT_USER=pod-root
MINIO_ROOT_PASSWORD=replace-me-at-least-16-chars
S3_ACCESS_KEY_ID=pod-app
S3_SECRET_ACCESS_KEY=replace-me-at-least-16-chars
S3_BUCKET=pod-studio
S3_REGION=us-east-1

# better-auth session signing secret (32+ random bytes, base64).
BETTER_AUTH_SECRET=replace-me

# Shopify credential encryption (P2-05). Comma-separated `<version>:<base64 32 bytes>` keys; the
# active version encrypts new values, older versions stay listed until re-encryption finishes.
SHOPIFY_ENCRYPTION_KEYS=v1:replace-with-base64-32-bytes
SHOPIFY_ENCRYPTION_ACTIVE_VERSION=v1

# Optional: host ports for Caddy (default 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443
