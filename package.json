{
  "name": "pod-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @pod-studio/web dev",
    "build": "pnpm --filter @pod-studio/web build",
    "start": "pnpm --filter @pod-studio/web start",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "services:up": "docker compose -f ops/local/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f ops/local/docker-compose.yml down",
    "services:reset": "docker compose -f ops/local/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @pod-studio/db generate",
    "db:migrate": "pnpm --filter @pod-studio/db migrate",
    "db:check": "pnpm --filter @pod-studio/db check",
    "auth:create-admin": "pnpm --filter @pod-studio/core create-admin",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "postgres": "3.4.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
