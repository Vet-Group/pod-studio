{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pod-studio.internal/contracts/v2/schemas/common.schema.json",
  "title": "Common definitions",
  "description": "Shared primitives used by the worker API and the skill manifest. Draft 2 for review.",
  "$defs": {
    "Id": {
      "description": "Opaque server-generated identifier (nanoid). Workers must treat it as an opaque string.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,40}$"
    },
    "Sha256": {
      "description": "Lowercase hex SHA-256 of the exact bytes.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "Locale": {
      "description": "BCP 47 tag. Always spell Portuguese as pt-PT or pt-BR explicitly.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "examples": ["en", "de", "fr", "pt-PT", "pt-BR"]
    },
    "Provider": {
      "description": "AI provider key. Open set so new providers need no contract bump. Known values: chatgpt, grok, gemini, openai, deepseek.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "ModelId": {
      "description": "Provider model chosen by the requester, for example nano-banana-pro or imagen-4 for gemini through Google Flow. Open set so new models need no contract bump. The worker selects exactly this model in the provider UI or fails the job.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "Channel": {
      "description": "browser = subscription account driven through a browser; api = metered API key.",
      "type": "string",
      "enum": ["browser", "api"]
    },
    "JobType": {
      "type": "string",
      "enum": ["mockup", "redesign", "listing_content", "product_analysis"]
    },
    "Ratio": {
      "type": "string",
      "enum": ["1:1", "3:4", "4:3", "2:3", "3:2", "4:5", "9:16", "16:9"]
    },
    "ImageContentType": {
      "type": "string",
      "enum": ["image/png", "image/jpeg", "image/webp"]
    },
    "AssetRef": {
      "description": "Input file handed to the worker as a short-lived presigned GET URL. Verify sha256 after download.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "assetId", "url", "urlExpiresAt", "sha256", "contentType", "bytes", "filename"],
      "properties": {
        "role": { "type": "string", "enum": ["design", "reference", "template", "source_result"] },
        "assetId": { "$ref": "#/$defs/Id" },
        "url": { "type": "string", "format": "uri" },
        "urlExpiresAt": { "$ref": "#/$defs/Timestamp" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "contentType": { "type": "string", "maxLength": 100 },
        "bytes": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "filename": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "SkillRef": {
      "description": "Immutable published skill version used to build this job. Fetch the manifest only if the worker needs more than the rendered prompt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "versionId", "slug", "kind", "version", "checksum"],
      "properties": {
        "skillId": { "$ref": "#/$defs/Id" },
        "versionId": { "$ref": "#/$defs/Id" },
        "slug": { "$ref": "#/$defs/Slug" },
        "kind": { "type": "string", "enum": ["prompt_template", "provider_skill", "niche_agent"] },
        "version": { "$ref": "#/$defs/SemVer" },
        "checksum": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ErrorClass": {
      "description": "Drives retry, attempt counting and account state. See README section 'Error classes'.",
      "type": "string",
      "enum": [
        "account_rate_limited",
        "account_session_expired",
        "account_unavailable",
        "provider_refused",
        "input_invalid",
        "transient",
        "cancelled"
      ]
    },
    "Problem": {
      "description": "RFC 9457 problem details. `code` is stable and machine-readable; `detail` is for humans.",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "title", "status", "code"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "code": {
          "type": "string",
          "enum": [
            "unauthorized",
            "forbidden",
            "not_found",
            "validation_failed",
            "lease_lost",
            "job_not_active",
            "account_not_claimable",
            "upload_missing",
            "checksum_mismatch",
            "rate_limited",
            "idempotency_key_reused",
            "contract_version_unsupported"
          ]
        },
        "detail": { "type": "string" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
