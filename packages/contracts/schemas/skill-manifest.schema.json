{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pod-studio.internal/contracts/v2/schemas/skill-manifest.schema.json",
  "title": "Skill manifest",
  "description": "Metadata stored for one immutable skill version. The webapp stores, versions, reviews and distributes skills; the skills runtime (owned by the workers side) executes them. Draft 1 for review.",
  "type": "object",
  "required": ["manifestVersion", "kind", "slug", "name", "version", "appliesTo"],
  "properties": {
    "manifestVersion": { "const": "1" },
    "kind": { "type": "string", "enum": ["prompt_template", "provider_skill", "niche_agent"] },
    "slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "version": { "$ref": "common.schema.json#/$defs/SemVer" },
    "description": { "type": "string", "maxLength": 2000 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team": { "type": "string", "maxLength": 120 },
        "contact": { "type": "string", "maxLength": 120 }
      }
    },
    "changelog": { "type": "string", "maxLength": 4000 },
    "appliesTo": {
      "description": "Where the skill may be bound. Empty arrays mean any.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jobTypes"],
      "properties": {
        "jobTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/JobType" } },
        "productTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 64 } },
        "niches": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 64 } },
        "providers": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Provider" } }
      }
    },
    "promptTemplate": { "$ref": "#/$defs/PromptTemplate" },
    "providerSkill": { "$ref": "#/$defs/ProviderSkill" },
    "nicheAgent": { "$ref": "#/$defs/NicheAgent" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "prompt_template" } }, "required": ["kind"] },
      "then": {
        "required": ["promptTemplate"],
        "properties": { "promptTemplate": true, "providerSkill": false, "nicheAgent": false }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "provider_skill" } }, "required": ["kind"] },
      "then": {
        "required": ["providerSkill"],
        "properties": { "providerSkill": true, "promptTemplate": false, "nicheAgent": false }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "niche_agent" } }, "required": ["kind"] },
      "then": {
        "required": ["nicheAgent"],
        "properties": { "nicheAgent": true, "promptTemplate": false, "providerSkill": false }
      }
    }
  ],
  "$defs": {
    "Variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
        "type": { "type": "string", "enum": ["string", "integer", "enum", "locale", "ratio"] },
        "required": { "type": "boolean", "default": true },
        "default": {},
        "enum": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "PromptTemplate": {
      "description": "Text rendered server-side with {{variable}} placeholders before dispatch. Workers receive the rendered prompt, so they never need a template engine.",
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "variables"],
      "properties": {
        "template": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "systemPrompt": { "type": "string", "maxLength": 20000 },
        "variables": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/Variable" } },
        "requiresProviderSkills": {
          "description": "Provider skills that must be installed on the account, e.g. a ChatGPT skill referenced as @create-wall-art-mockups. The scheduler only dispatches to accounts that report these installed.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Slug" }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expectedCount": { "type": "integer", "minimum": 1, "maximum": 20 },
            "ratio": { "$ref": "common.schema.json#/$defs/Ratio" },
            "format": { "type": "string", "enum": ["images", "json"] },
            "jsonSchemaRef": { "type": "string", "description": "For format=json: a $ref into job.schema.json, e.g. job.schema.json#/$defs/ListingContentPayload" }
          }
        }
      }
    },
    "ProviderSkill": {
      "description": "A skill that lives inside a provider account (for example a ChatGPT custom skill). The webapp tracks which accounts have which version installed; installation itself is done on the workers side.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "externalName", "mention"],
      "properties": {
        "provider": { "$ref": "common.schema.json#/$defs/Provider" },
        "externalName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mention": { "type": "string", "pattern": "^@[a-z0-9][a-z0-9-]{1,63}$", "description": "Token that must be typed with real keystrokes so the provider UI resolves it." },
        "installGuideUrl": { "type": "string", "format": "uri" },
        "sourceArtifact": { "$ref": "#/$defs/Artifact" }
      }
    },
    "NicheAgent": {
      "description": "Packaged niche design skill (SKILL.md and references) built from master data, as produced by the POD skill builder.",
      "type": "object",
      "additionalProperties": false,
      "required": ["niche", "masterDataSchemaVersion", "artifact", "entrypoint"],
      "properties": {
        "niche": { "type": "string", "minLength": 1, "maxLength": 64 },
        "masterDataSchemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$", "examples": ["2.0"] },
        "masterData": { "$ref": "#/$defs/Artifact" },
        "artifact": { "$ref": "#/$defs/Artifact" },
        "entrypoint": { "type": "string", "default": "SKILL.md", "maxLength": 255 },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "validatorVersion"],
          "properties": {
            "status": { "type": "string", "enum": ["passed", "failed"] },
            "validatorVersion": { "type": "string", "maxLength": 64 },
            "checkedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "issues": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["severity", "path", "message"],
                "properties": {
                  "severity": { "type": "string", "enum": ["error", "warning"] },
                  "path": { "type": "string", "maxLength": 300 },
                  "message": { "type": "string", "maxLength": 1000 }
                }
              }
            }
          }
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageKey", "sha256", "bytes", "contentType"],
      "properties": {
        "storageKey": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "common.schema.json#/$defs/Sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "contentType": { "type": "string", "maxLength": 100 }
      }
    }
  }
}
